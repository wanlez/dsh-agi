{
  "name": "dsh-agi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit -p packages/computer-use/tsconfig.json && tsc --noEmit -p packages/host/tsconfig.json && tsc --noEmit -p packages/helper/tsconfig.json && tsc --noEmit -p packages/client-settings/tsconfig.json && tsc --noEmit -p packages/voice/tsconfig.json",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-isolation=process packages/host/tests/*.test.ts packages/helper/tests/*.test.ts packages/voice/tests/*.test.ts packages/client-settings/tests/*.test.mjs packages/bundle/tests/*.test.mjs && pnpm --filter @dsh-agi/computer-use test",
    "test:graph": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-isolation=none packages/host/tests/knowledge-graph.test.ts packages/host/tests/knowledge-graph-keyword.test.ts packages/host/tests/knowledge-graph-semantic.test.ts packages/host/tests/knowledge-graph-routes.test.ts packages/host/tests/knowledge-graph-library.test.ts packages/host/tests/knowledge-graph-editor.test.ts packages/host/tests/knowledge-graph-write.test.ts",
    "dev:graph": "node --experimental-transform-types packages/host/src/knowledge-graph/dev-server.ts",
    "import:legacy": "node --experimental-transform-types packages/host/tools/import-legacy-experience.ts",
    "smoke:graph": "node --experimental-transform-types packages/host/tools/graph-smoke.ts",
    "release:check": "node scripts/release-check.mjs",
    "test:web": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test --test-isolation=none packages/host/tests/web.test.ts packages/host/tests/web-labels.test.ts packages/host/tests/session-mode.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "playwright-core": "1.65.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  }
}
